<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	
	<TieredCompilation>true</TieredCompilation>
  	<TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    
    	<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
	<DebugType>portable</DebugType>
	<ConcurrentBuild>true</ConcurrentBuild>
    
    	<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  	<BuildInParallel>true</BuildInParallel>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.2.0" />
      <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
      <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.2.0" />
      <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
      <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
      <PackageReference Include="Avalonia.Diagnostics" Version="11.3.23" />
      <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
      <PackageReference Include="Avalonia.Markup.Declarative" Version="12.2.0" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
      <PackageReference Include="Avalonia.Themes.Simple" Version="12.2.0" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
      <PackageReference Include="Humanizer.Core" Version="3.0.10" />
      <PackageReference Include="Markdig" Version="1.6.0" />
      <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.2" />
      <PackageReference Include="MattEqualsCoder.AvaloniaControls" Version="12.0.0" />
      <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.CodeAnalysis.AnalyzerUtilities" Version="5.6.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.12.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.12.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.12.0" />
      <PackageReference Include="Microsoft.DiaSymReader" Version="3.0.0" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
      <PackageReference Include="NuGet.Common" Version="8.0.0" />
      <PackageReference Include="NuGet.Configuration" Version="8.0.0" />
      <PackageReference Include="NuGet.Protocol" Version="8.0.0" />
      <PackageReference Include="NuGet.Versioning" Version="8.0.0" />
      <PackageReference Include="ReactiveUI" Version="28.0.0" />
      <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.9" />
      <PackageReference Include="Semi.Avalonia" Version="12.1.0.2" />
      <PackageReference Include="Semi.Avalonia.AvaloniaEdit" Version="12.0.0" />
      <PackageReference Include="System.Composition" Version="11.0.0" />
      <PackageReference Include="System.Configuration.ConfigurationManager" Version="11.0.0" />
      <PackageReference Include="System.Diagnostics.EventLog" Version="11.0.0" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
      <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    </ItemGroup>

    <Target Name="EnsureAvaloniaXamlCompiled" AfterTargets="CoreCompile" DependsOnTargets="CompileAvaloniaXaml" Condition="'$(DesignTimeBuild)' != 'true' and '$(EnableAvaloniaXamlCompilation)' != 'false'" />

</Project>
